# Скопируйте в .env и заполните подходящий вариант.

# ============================================================
# Вариант 1 (по умолчанию): Pollinations — бесплатно, без ключа,
# работает из РФ. Лимит: 1 запрос в 45 секунд с одного IP.
# ============================================================
LLM_CHAT_URL=https://text.pollinations.ai/openai
LLM_MODEL=openai
LLM_ALLOW_NO_KEY=1
LLM_TIMEOUT=120
LLM_BASE_URL=https://text.pollinations.ai

# ============================================================
# Вариант 2: облачный провайдер с ключом (OpenAI, DeepSeek,
# SambaNova, VseGPT, ProxyAPI и т.п.)
# ============================================================
# LLM_CHAT_URL=https://api.openai.com/v1/chat/completions
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_ALLOW_NO_KEY=0

# Если провайдер блокирует РФ (OpenRouter, OpenAI), задайте прокси:
# HTTPS_PROXY=http://127.0.0.1:1080
# или используйте провайдера, доступного из РФ (DeepSeek, VseGPT, SambaNova).

# ============================================================
# Вариант 3: локальная Ollama — бесплатно, без лимитов и без сети.
# ============================================================
# LLM_CHAT_URL=http://127.0.0.1:11434/v1/chat/completions
# LLM_MODEL=qwen2.5:3b-instruct
# LLM_ALLOW_NO_KEY=1
# LLM_TIMEOUT=300
# LLM_BASE_URL=http://127.0.0.1:11434/v1

# 1 — принудительно демо-режим без вызовов LLM
ROADLY_DEMO=0

# Секрет для подписи сессионных cookie (обязательно задайте свой в проде)
SESSION_SECRET=change-me-to-a-random-string

# 1 — cookie сессии только по HTTPS. Включайте на продакшене за HTTPS.
SESSION_HTTPS_ONLY=0

# База данных. По умолчанию SQLite-файл roadly.db в корне проекта.
# Для PostgreSQL установите psycopg[binary] и укажите строку подключения:
# DATABASE_URL=postgresql+psycopg://roadly:password@127.0.0.1:5432/roadly
# DATABASE_URL=sqlite:///./roadly.db
