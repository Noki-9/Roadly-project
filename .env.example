# ============================================================
# Roadly — пример конфигурации
# Скопируйте файл и заполните значения:
#   cp .env.example .env
# Файл .env не попадает в git.
# ============================================================

# ------------------------------------------------------------
# LLM: OpenRouter, бесплатная Gemma 4 31B
# Ключ: https://openrouter.ai/settings/keys
# Бесплатный тариф: около 50 запросов в сутки.
# Из РФ OpenRouter может отвечать 403 — нужен VPN или прокси.
# ------------------------------------------------------------
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_CHAT_URL=https://openrouter.ai/api/v1/chat/completions
LLM_MODEL=google/gemma-4-31b-it:free
LLM_API_KEY=sk-or-v1-...
LLM_ALLOW_NO_KEY=0
LLM_TIMEOUT=120
LLM_MAX_TOKENS=8192

# Другая бесплатная Gemma на OpenRouter (MoE, 26B):
# LLM_MODEL=google/gemma-4-26b-a4b-it:free

# ------------------------------------------------------------
# Альтернатива без ключа: Pollinations (доступна из РФ)
# ------------------------------------------------------------
# LLM_BASE_URL=https://text.pollinations.ai
# LLM_CHAT_URL=https://text.pollinations.ai/openai
# LLM_MODEL=openai
# LLM_API_KEY=
# LLM_ALLOW_NO_KEY=1

# ------------------------------------------------------------
# Режим приложения
# 1 — всегда отдавать демо-roadmap, не обращаясь к LLM
# ------------------------------------------------------------
ROADLY_DEMO=0

# ------------------------------------------------------------
# Сессии
# Сгенерировать секрет:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# ------------------------------------------------------------
SESSION_SECRET=change-me-please
# 1 — cookie сессии только по HTTPS (включайте за reverse-proxy)
SESSION_HTTPS_ONLY=0

# ------------------------------------------------------------
# База данных
# По умолчанию — SQLite-файл roadly.db в корне проекта.
# В Docker Compose переменная переопределяется на /app/data/roadly.db.
# Пример PostgreSQL:
# DATABASE_URL=postgresql+psycopg://roadly:password@127.0.0.1:5432/roadly
# ------------------------------------------------------------
# DATABASE_URL=sqlite:///roadly.db

# ------------------------------------------------------------
# Необязательно: прокси для доступа к OpenRouter из РФ.
# httpx читает HTTPS_PROXY из окружения автоматически.
# ------------------------------------------------------------
# HTTPS_PROXY=http://127.0.0.1:1080
